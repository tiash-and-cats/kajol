#!/usr/bin/env bash

# Array of all targeted Python versions
VERSIONS=("3.9" "3.10" "3.11" "3.12" "3.13" "3.14")

for v in "${VERSIONS[@]}"; do
    echo "========================================="
    echo "Processing Python $v"
    echo "========================================="

    # 1. Flash-install the local wheel file directly to the targeted system path
    python$v -m pip install --break-system-packages ./kajol-1.3.0-cp314-none-any.whl

    # 2. Run your verification test script against that specific version
    python$v -c "import kajol; print('Successfully verified kajol on version:', '$v')"
    
    echo ""
done